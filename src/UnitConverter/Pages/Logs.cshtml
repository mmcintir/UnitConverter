@page "{handler?}"
@using UnitConverter.Models
@model UnitConverter.Pages.Logs

<!DOCTYPE html>

<html>
<head>
    <title>Logs</title>
</head>
<body>
<div>
    <form method="get">
        <label asp-for="Level" class="form-label">Level</label>
        <select asp-for="Level" class="form-select">
            <option value="">All</option>
            <option value="Information">Information</option>
            <option value="Warning">Warning</option>
            <option value="Error">Error</option>
        </select>
        <label asp-for="ConversionType" class="form-label">Conversion Type</label>
        <select asp-for="ConversionType" class="form-select">
            <option value="">All</option>
            @foreach (var conversion in ConversionTypes.All)
            {
                <option value="@conversion.Key">@conversion.Value</option>
            }
        </select>
        <label asp-for="Search" class="form-label">Search</label>
        <input asp-for="Search" type="text"  class="form-control"></input>
        <a asp-page="/Logs" class="btn btn-secondary">Clear</a>
        <button class="btn btn-primary">Submit</button>
    </form>
        <table class="table table-striped">
            <thead>
            <tr>
                <th scope="col">Timestamp</th>
                <th scope="col">Level</th>
                <th scope="col">Message</th>
                <th scope="col">Conversion</th>
                <th scope="col">Input</th>
                <th scope="col">Result</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var entry in Model.Entries)
            {
                @if((Model.Level == null || entry.Level == Model.Level)
                    && (Model.ConversionType == null || entry.ConversionType == Model.ConversionType)
                    && ((string.IsNullOrEmpty(Model.Search) || (entry.Message?.Contains(Model.Search, StringComparison.OrdinalIgnoreCase) ?? false))))
                {
                    <tr>
                        <td>@entry.Timestamp</td>
                        <td>@entry.Level</td>
                        <td>@entry.Message</td>
                        <td>@entry.ConversionType</td>
                        <td>@entry.Input</td>
                        <td>@entry.Result</td>
                    </tr>
                }
            }
            </tbody>
        </table>
</div>
</body>
</html>
